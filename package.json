{
  "name": "wedding-invitation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "invite": "node scripts/invitation-tools.mjs",
    "invite:validate": "node scripts/invitation-tools.mjs validate --all",
    "invite:preflight": "node scripts/invitation-tools.mjs preflight --all",
    "invite:assets": "node scripts/invitation-tools.mjs assets",
    "invite:optimize": "node scripts/invitation-tools.mjs optimize",
    "context:refresh": "node scripts/invitation-inventory.mjs refresh",
    "context:check": "node scripts/invitation-inventory.mjs check",
    "production:boundary": "node scripts/check-production-boundary.mjs",
    "publish:check": "node scripts/invitation-tools.mjs preflight --all && node scripts/invitation-inventory.mjs check && vite build && node scripts/check-production-boundary.mjs",
    "deploy": "git add . && git commit -m \"deploy: update\" && git push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "gsap": "^3.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "vite": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18"
  }
}
