# Supabase credentials for RSVP and shared album functionality
# Copy this file to .env and fill in your values:
#   cp .env.example .env

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Private server-only Google Drive connection for Gretel & Geraldine's album.
# Configure these in Vercel; never prefix them with VITE_ and never commit real values.
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_GRETEL_GERALDINE_FOLDER_ID=your-private-drive-folder-id

# Optional comma-separated allowlist for browser uploads.
ALBUM_ALLOWED_ORIGINS=https://invita-ya.com
